[Desktop Entry]
Type=Application
Name=Snappy
Comment=Capture your screen
Comment[es]=Captura tu pantalla
Comment[el]=Λήψη της οθόνης σας
Comment[pt_BR]=Capture sua tela
Comment[pt_PT]=Capture o seu ecrã
Exec=/usr/lib/snappy/launch
Icon=io.github.snappy.Capture
StartupWMClass=io.github.snappy.Capture
Terminal=false
Categories=Utility;AudioVideo;
StartupNotify=true
Keywords=screenshot;record;capture;
Keywords[es]=captura;imagen;grabar;pantalla;
Keywords[el]=στιγμιότυπο;εγγραφή;λήψη;οθόνη;
Keywords[pt_BR]=captura;imagem;gravar;tela;
Keywords[pt_PT]=captura;imagem;gravar;ecrã;
